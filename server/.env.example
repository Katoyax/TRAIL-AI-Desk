PORT=3000
# No default database credentials. Without MongoDB, only labeled demo reads work.
MONGODB_URI=
MONGODB_DATABASE=trail_ai_desk

# Server-only Gemini keys. With no key, verified lexical/extractive answers work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
# Optional Atlas vector index. Leave empty for bounded local cosine retrieval.
MONGODB_VECTOR_INDEX=
RETRIEVAL_MIN_COSINE=0.45

# Only approved university domains can be fetched. Redirects/DNS are validated.
SOURCE_ALLOWED_DOMAINS=ustp.edu.ph
SOURCE_REFRESH_ENABLED=true
SOURCE_REFRESH_INTERVAL_HOURS=24
SOURCE_REFRESH_POLL_MS=60000

AUTH_SESSION_HOURS=12
PASSWORD_RESET_MINUTES=15
# HTTPS deployed reset screen URL; localhost HTTP permitted for development.
RESET_PASSWORD_URL=
RESEND_API_KEY=
# Must be an actual provider-verified sender.
RESET_EMAIL_FROM=
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006

# Legacy adapter retained for existing setups; Gemini takes precedence.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
